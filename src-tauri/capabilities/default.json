{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Standardberechtigungen für Haupt- und Splashscreen-Fenster",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
