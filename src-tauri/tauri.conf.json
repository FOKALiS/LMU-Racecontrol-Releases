{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LMU RACECONTROL",
  "version": "0.6.1",
  "identifier": "com.yourteam.lmuracecontrol",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 960,
        "height": 682,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true,
        "shadow": true
      },
      {
        "label": "main",
        "title": "LMU RACECONTROL – Vorfall-Kommission",
        "width": 1600,
        "height": 950,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": true
      }
    },
    "publisher": "Your Race Control Team",
    "copyright": "© 2026 Your Race Control Team",
    "category": "Utility",
    "shortDescription": "LIVE Vorfall-Analyse-Tool für Le Mans Ultimate Rennkommissionen",
    "longDescription": "Werkzeug für Rennkommissare zur Live-Erkennung, Dokumentation und Nachverfolgung von Vorfällen (Kollisionen, Regelverstöße) während Endurance-Rennen in Le Mans Ultimate."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/FOKALiS/LMU-Racecontrol/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERENEZERjg5QjI3RDFCNzQKUldSMEczMnlpZDlQM1gvUmRlYThOWlEyd2g1MmFtcGYxZHY4M0NLb0liNEh5bnRzaExOQk83TXIK"
    }
  }
}
